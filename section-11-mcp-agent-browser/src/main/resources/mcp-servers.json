{
  "mcpServers": {
    "playwright-browser": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--viewport-size=1920,1080",
        "--user-data-dir=./.playwright-mcp-profile"
      ],
      "env": {
        "PLAYWRIGHT_HEADLESS": "false"
      }
    }
  }
}